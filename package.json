{
  "name": "team-base",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "convex dev --start \"vp dev\"",
    "deploy": "node ./scripts/check-keys.ts && convex-hosting deploy --build \"node ./scripts/ensure-convex-auth.ts && vp build\" --dist dist/client --html-handling drop-trailing-slash",
    "deploy:dev": "convex-hosting deploy --dev --build \"node ./scripts/ensure-convex-auth.ts && vp build\" --dist dist/client --html-handling drop-trailing-slash",
    "keys:init": "node ./scripts/init-keys.ts",
    "check": "vp fmt --check && vp lint && pnpm run typecheck",
    "typecheck": "tsc --project convex/tsconfig.json && tsc --project tsconfig.node.json && tsc --project tsconfig.app.json",
    "format": "vp fmt",
    "lint": "vp lint"
  },
  "dependencies": {
    "@convex-dev/auth": "2.0.0-beta.0",
    "@convex-dev/react-query": "^0.1.0",
    "@samebase/alchemy-convex": "0.15.0",
    "@samebase/convex-auth-tanstack-start": "^0.1.1",
    "@samebase/convex-hosting": "^0.14.0",
    "@samebase/convex-hosting-tanstack-start": "^0.11.0",
    "@samebase/identity-broker": "0.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.3",
    "convex": "1.48.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.5",
    "@tanstack/router-plugin": "^1.168.47",
    "@types/node": "24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "alchemy": "2.0.0-beta.84",
    "effect": "4.0.5",
    "typescript": "7.0.2",
    "vite-plus": "1.3.0"
  },
  "packageManager": "pnpm@12.12.1"
}
