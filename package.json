{
  "name": "identity-hub",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "deploy": "node ./scripts/check-keys.ts && convex deploy --yes",
    "keys:init": "node ./scripts/init-keys.ts",
    "check": "vp check && pnpm run typecheck && vp test",
    "typecheck": "tsc --project convex/tsconfig.json && tsc --project tsconfig.node.json",
    "format": "vp fmt",
    "lint": "vp lint --report-unused-disable-directives",
    "test": "vp test"
  },
  "dependencies": {
    "@samebase/identity-broker": "0.33.0",
    "convex": "1.48.0"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.2",
    "@samebase/alchemy-convex": "0.40.0",
    "@types/node": "26.6.6",
    "alchemy": "2.0.0-beta.85",
    "effect": "4.1.2",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.16.1"
}
