{
  "name": "identity-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "convex dev",
    "deploy": "node ./scripts/check-keys.ts && convex deploy --yes",
    "keys:init": "node ./scripts/init-keys.ts",
    "check": "vp fmt --check && vp lint && pnpm run typecheck",
    "typecheck": "tsc --project convex/tsconfig.json && tsc --project tsconfig.node.json",
    "format": "vp fmt",
    "lint": "vp lint"
  },
  "dependencies": {
    "@samebase/identity-broker": "0.6.0",
    "convex": "1.47.0"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.5",
    "@samebase/alchemy-convex": "0.11.0",
    "@types/node": "24.19.2",
    "alchemy": "2.0.0-beta.84",
    "effect": "4.0.5",
    "typescript": "7.0.2",
    "vite-plus": "1.3.0"
  },
  "packageManager": "pnpm@12.12.1"
}
